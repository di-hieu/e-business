# SC Chatbot Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# SECURITY
# =============================================================================
# Generate a strong random secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=${JWT_SECRET_KEY:-your-secret-key-change-in-production}

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# OpenAI API key or OpenRouter API key
LLM_API_KEY=${LLM_API_KEY:-}
# LLM Model (GPT-4o-mini for POC, upgrade to GPT-4o or Claude later)
LLM_MODEL=gpt-4o-mini

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
# Use local all-MiniLM-L6-v2 for POC (free, no API costs)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite for POC (production: use PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL connection string (for production)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sc_chatbot

# =============================================================================
# FAISS CONFIGURATION
# =============================================================================
# Directory for storing FAISS indexes
FAISS_DIR=./data/faiss

# =============================================================================
# RATE LIMITING
# =============================================================================
# Requests per minute per tenant (adjust based on your needs)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# ZALO CONFIGURATION (for POC)
# =============================================================================
# Zalo Official Account API credentials
ZALO_APP_ID=${ZALO_APP_ID:-}
ZALO_APP_SECRET=${ZALO_APP_SECRET:-}
ZALO_REDIRECT_URI=${ZALO_REDIRECT_URI:-http://localhost:8000/auth/zalo/callback}

# =============================================================================
# TELEGRAM CONFIGURATION (for POC)
# =============================================================================
# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN:-}
# Telegram webhook URL
TELEGRAM_WEBHOOK_URL=${TELEGRAM_WEBHOOK_URL:-https://your-domain.com/webhooks/telegram}
# Telegram webhook verification token (optional)
TELEGRAM_VERIFICATION_TOKEN=${TELEGRAM_VERIFICATION_TOKEN:-}
# Telegram inline mode bot token (for /start command, etc.)
TELEGRAM_INLINE_BOT_TOKEN=${TELEGRAM_INLINE_BOT_TOKEN:-}

# =============================================================================
# FACEBOOK CONFIGURATION (for MVP)
# =============================================================================
# Facebook Messenger App credentials
FACEBOOK_APP_ID=${FACEBOOK_APP_ID:-}
FACEBOOK_APP_SECRET=${FACEBOOK_APP_SECRET:-}
FACEBOOK_VERIFY_TOKEN=${FACEBOOK_VERIFY_TOKEN:-}
FACEBOOK_ACCESS_TOKEN=${FACEBOOK_ACCESS_TOKEN:-}

# =============================================================================
# INSTAGRAM CONFIGURATION (for Production)
# =============================================================================
# Instagram Graph API credentials
INSTAGRAM_ACCESS_TOKEN=${INSTAGRAM_ACCESS_TOKEN:-}
INSTAGRAM_APP_ID=${INSTAGRAM_APP_ID:-}
INSTAGRAM_APP_SECRET=${INSTAGRAM_APP_SECRET:-}

# =============================================================================
# OPENROUTER (Alternative to OpenAI)
# =============================================================================
# OpenRouter API key for accessing multiple LLM providers
OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Application hostname (for CORS, webhook signatures, etc.)
HOSTNAME=${HOSTNAME:-http://localhost:8000}

# Enable debug mode (disable in production)
DEBUG=${DEBUG:-True}

# =============================================================================
# LOGGING
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO