"""
SC Chatbot User Model

User authentication and authorization model.
"""

from sqlalchemy import Column, Integer, String, Boolean, DateTime, Enum
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import relationship
from enum import Enum as SQLEnum


class UserRole(SQLEnum):
    """User roles for RBAC."""
    ADMIN = "admin"
    TENANT_ADMIN = "tenant_admin"
    AGENT = "agent"


class User:
    """Represents a user within a tenant."""
    
    __tablename__ = "users"
    
    id = Column(Integer, primary_key=True, index=True)
    email = Column(String(255), unique=True, index=True, nullable=False, comment="User email")
    hashed_password = Column(String(255), nullable=False, comment="Bcrypt hashed password")
    
    # Role and permissions
    role = Column(Enum(UserRole), default=UserRole.AGENT, nullable=False)
    
    # Relationships
    # Note: For backward compatibility and lazy loading, we define tenant_id
    # as a class attribute pointing to the tenant relationship even though it's not used in __init__
    from .tenant import Tenant
    tenant = relationship("Tenant", back_populates="users", foreign_keys=[Tenant.id])
    
    # tenant_id used for backward compatibility with old relationship references
    
    def __init__(self, email: str, hashed_password: str, tenant_id: int,
                role: UserRole = UserRole.AGENT):
        self.email = email
        self.hashed_password = hashed_password
        self.tenant_id = tenant_id
        self.role = role
    
    def __init__(self, email: str, hashed_password: str, tenant_id: int,
                 role: UserRole = UserRole.AGENT):
        self.email = email
        self.hashed_password = hashed_password
        self.tenant_id = tenant_id
        self.role = role

    def to_dict(self):
        """Convert to dictionary."""
        return {
            "id": self.id,
            "email": self.email,
            "hashed_password": self.hashed_password,
            "role": self.role.value,
            "tenant_id": self.tenant_id,
            "created_at": self.created_at,
            "updated_at": self.updated_at
        }

    def __repr__(self):
        return f"<User(email='{self.email}', role='{self.role.value}')>"